---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/PageIntro.astro";

const lastUpdated = "September 2026";

const sectionsArchived= [
  {
    label: "Building",
    body: "Web application and backend work by day, plus small tools I build to understand how something works.",
  },
  { label: "Learning", body: "Going deeper into Node.js, React, SQL and system design." },
  {
    label: "Exploring",
    body: "Tidying up my personal finance setup and experimenting with small tools around it.",
  },
  {
    label: "Looking forward to",
    body: "More time outside, clearer routines, and steady progress on the things that matter.",
  },
];

const sections = [
  { label: "Parenting", body: "Blessed to be a dad, stepped into parent life, getting used to her giggles, moos, wet and dirty nappies. Sleep is better nowadays, compared to her newborn phase" },
  {
    label: "Home",
    body: "After what felt like a thousand viewings, we bought a house and moved in. The back garden is done to a basic stage: old soil and weeds cleared, new grass down, a spot set aside for a shed, and planter boxes on either side edged in dark grey cobblestone. The rest of the place is slowly becoming ours.",
  },
  {
    label: "Exploring",
    body: "Tidying up my personal finance setup and experimenting with <a href='https://actualbudget.org/'actual budget.</a> <a href='https://github.com/emilgeo/actual/branches'Contributing</a> in order to make it a little more better, in addition to building small tools around it.",
  }
];
---

<BaseLayout title="Now" description="What Emil George is focused on at the moment.">
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-24 sm:pt-24">
    <PageIntro eyebrow={`Now · updated ${lastUpdated}`} title="What I'm focused on right now." />

    <dl class="mt-10 grid gap-4">
      {
        sections.map((item) => (
          <div class="border-line grid gap-1 border-b pb-4 sm:grid-cols-[10rem_1fr] sm:gap-6">
            <dt class="text-ink-soft font-mono text-xs tracking-wide uppercase">{item.label}</dt>
            <dd class="text-ink-soft">{item.body}</dd>
          </div>
        ))
      }
    </dl>

    <p class="text-ink-soft mt-10 max-w-xl text-sm">
      This is a <a href="https://nownownow.com/about" class="text-signal hover:underline">now page</a
      >: what has my attention at the moment, rather than everything I have ever done.
    </p>
  </section>
</BaseLayout>
