---
import BaseLayout from "../layouts/BaseLayout.astro";

// Disabled for now. Move this file back to src/pages/projects.astro to restore the route.
const projects = [
  {
    title: "House purchase",
    status: "In progress",
    description: "Working through the moving pieces of buying a home.",
  },
  {
    title: "Garden makeover",
    status: "Planning",
    description: "Sketching out a simple garden that feels good to spend time in.",
  },
  {
    title: "Personal finance stack",
    status: "Ongoing",
    description: "Building a small, dependable system for budgeting and planning.",
  },
];
---

<BaseLayout title="Projects | Emil George">
  <h1>Projects</h1>
  <div class="card-grid">
    {
      projects.map((project) => (
        <article class="card">
          <h2>{project.title}</h2>
          <p>{project.description}</p>
          <span class="status">{project.status}</span>
        </article>
      ))
    }
  </div>
</BaseLayout>
