---
import ThemeToggle from "@/components/ThemeToggle.astro";
import { externalNavLinks, site, visibleNavLinks } from "@/site";

const currentPath = Astro.url.pathname;
---

<header class="border-line bg-paper/90 sticky top-0 z-40 border-b backdrop-blur">
  <div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-6 py-4">
    <a href="/" class="font-display text-ink flex items-center gap-2.5 text-lg font-medium">
      <svg
        viewBox="0 0 64 64"
        class="h-6 w-6 shrink-0"
        role="img"
        aria-label="Emil George"
      >
        <rect class="fill-signal" width="64" height="64" rx="12" />
        <path class="fill-paper" d="M18 12h28v7H27v9h16v7H27v10h19v7H18V12Z" />
      </svg>
      {site.name}
    </a>

    <nav class="flex items-center gap-5" aria-label="Primary">
      {
        visibleNavLinks.map((link) => {
          const isActive = currentPath === link.href || currentPath.startsWith(`${link.href}/`);
          return (
            <a
              href={link.href}
              aria-current={isActive ? "page" : undefined}
              class:list={[
                "font-mono text-xs tracking-wide uppercase transition-colors",
                isActive ? "text-signal" : "text-ink-soft hover:text-ink",
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
      {
        externalNavLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={link.label}
            class="font-mono text-xs font-semibold tracking-wide transition-opacity hover:opacity-80"
          >
            <span aria-hidden="true"
              ><span class="text-ink">india</span><span class="text-[#e8892b] dark:text-[#f2a65a]">2</span><span class="text-[#8719e0] dark:text-[#b37cf2]">actual</span></span
            >
          </a>
        ))
      }
      <ThemeToggle />
    </nav>
  </div>
</header>
