---
import { site, published } from "@/site";

const year = new Date().getFullYear();
---

<footer class="border-line border-t">
  <div
    class="text-ink-soft mx-auto flex max-w-3xl flex-col gap-4 px-6 py-8 font-mono text-xs sm:flex-row sm:items-center sm:justify-between"
  >
    <p>&copy; {year} {site.name}</p>

    <nav class="flex flex-wrap items-center gap-4" aria-label="Elsewhere">
      {
        site.social.map((link) => (
          <a href={link.href} class="hover:text-signal transition-colors" rel="me">
            {link.label}
          </a>
        ))
      }
      <a href={`mailto:${site.email}`} class="hover:text-signal transition-colors">Email</a>
      {published.writing && <a href="/rss.xml" class="hover:text-signal transition-colors">RSS</a>}
      <a href="#top" class="hover:text-signal transition-colors">Top &uarr;</a>
    </nav>
  </div>
</footer>
