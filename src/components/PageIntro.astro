---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<p class="text-ink-soft mb-6 font-mono text-xs tracking-[0.2em] uppercase">{eyebrow}</p>
<h1 class="font-display text-ink max-w-xl text-3xl font-medium sm:text-4xl">{title}</h1>
{lead && <p class="text-ink-soft mt-6 max-w-xl">{lead}</p>}
